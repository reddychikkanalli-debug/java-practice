package DSA;

import java.util.Scanner;

public class alpha {
	
	public static int trialZero(int n) {
		int res=0;
		int powOf5=5;
		while(n>=powOf5) {
			res=res+(n/powOf5);
			powOf5 = powOf5 * 5;
		}
		return res;
		
	}

	public static void main(String[] args) {
	Scanner sc= new Scanner(System.in);
	int a=sc.nextInt();
	System.out.println(trialZero(a));

	}

}
